# Browser-visible local API address; this is not a secret.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Exact local frontend origin permitted by FastAPI CORS.
FRONTEND_ORIGIN=http://localhost:3000
# For the public API, set this to the exact provider-issued HTTPS frontend origin.

# Spec 01 local catalog only. Run backend/scripts/configure_local_reader.py to
# generate backend/.env.local with a disposable, read-only database credential.
# APP_ENV=local
# ENABLE_DEV_CATALOG=1
# CATALOG_DATABASE_URL=postgresql://catalog_reader:<local-password>@127.0.0.1:54322/postgres
